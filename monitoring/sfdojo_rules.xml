<!-- SF Dojo voor Wazuh: gebeurtenissen uit /var/log/sfdojo/sfdojo-events.log (JSON) en Caddy-toegangslogs.
     Regel-id's 100100-100299 zijn voor eigen regels gereserveerd. -->
<group name="sfdojo,">

  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="event">^login_success$</field>
    <description>SF Dojo: succesvolle login in het beheer.</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100101" level="5">
    <decoded_as>json</decoded_as>
    <field name="event">^login_failed$</field>
    <description>SF Dojo: mislukte login in het beheer.</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100102" level="8">
    <decoded_as>json</decoded_as>
    <field name="event">^login_blocked$</field>
    <description>SF Dojo: loginpoging vanaf een geblokkeerd IP-adres.</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100103" level="10">
    <decoded_as>json</decoded_as>
    <field name="event">^ip_banned$</field>
    <description>SF Dojo: IP-adres geblokkeerd na te veel mislukte pogingen (ban 24u, 48u, 96u, ...).</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100115" level="10" frequency="3" timeframe="120">
    <if_matched_sid>100101</if_matched_sid>
    <same_source_ip />
    <description>SF Dojo: 3 mislukte logins in 2 minuten vanaf hetzelfde IP (brute force).</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100104" level="12" frequency="5" timeframe="300">
    <if_matched_sid>100102</if_matched_sid>
    <same_source_ip />
    <description>SF Dojo: blijft proberen vanaf een geblokkeerd IP-adres.</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100105" level="6">
    <decoded_as>json</decoded_as>
    <field name="event">^2fa_fail$</field>
    <description>SF Dojo: foute tweestapsverificatie-code.</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100106" level="6">
    <decoded_as>json</decoded_as>
    <field name="event">^sso_denied$</field>
    <description>SF Dojo: Google/Microsoft-account zonder toegang probeerde in te loggen.</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100107" level="7">
    <decoded_as>json</decoded_as>
    <field name="event">^rate_limited$</field>
    <description>SF Dojo: te veel verzoeken op een inlog- of herstel-eindpunt.</description>
  </rule>

  <rule id="100108" level="4">
    <decoded_as>json</decoded_as>
    <field name="event">^password_changed$</field>
    <description>SF Dojo: wachtwoord gewijzigd.</description>
  </rule>

  <rule id="100109" level="4">
    <decoded_as>json</decoded_as>
    <field name="event">^password_reset_requested$</field>
    <description>SF Dojo: wachtwoordherstel aangevraagd.</description>
  </rule>

  <rule id="100110" level="8">
    <decoded_as>json</decoded_as>
    <field name="event">^password_reset_done$</field>
    <description>SF Dojo: wachtwoord opnieuw ingesteld via een herstellink.</description>
  </rule>

  <rule id="100111" level="8">
    <decoded_as>json</decoded_as>
    <field name="event">^temp_password_issued$</field>
    <description>SF Dojo: tijdelijk wachtwoord uitgegeven door de eigenaar.</description>
  </rule>

  <rule id="100112" level="9">
    <decoded_as>json</decoded_as>
    <field name="event">^2fa_disabled$</field>
    <description>SF Dojo: tweestapsverificatie uitgezet of gereset.</description>
  </rule>

  <rule id="100113" level="8">
    <decoded_as>json</decoded_as>
    <field name="event">^2fa_recovery_used$</field>
    <description>SF Dojo: een herstelcode voor tweestapsverificatie is gebruikt.</description>
  </rule>

  <rule id="100114" level="6">
    <decoded_as>json</decoded_as>
    <field name="event">^user_updated$</field>
    <description>SF Dojo: gebruikersnaam of e-mailadres van een beheerder gewijzigd.</description>
  </rule>

  <!-- Caddy-toegangslog (JSON) -->
  <rule id="100200" level="0">
    <decoded_as>json</decoded_as>
    <field name="logger">http.log.access</field>
    <description>SF Dojo: Caddy-toegangslog.</description>
  </rule>

  <rule id="100201" level="6">
    <if_sid>100200</if_sid>
    <field name="status">^5\d\d$</field>
    <description>SF Dojo: de website gaf een serverfout (5xx).</description>
  </rule>

  <rule id="100202" level="5">
    <if_sid>100200</if_sid>
    <field name="status">^40[13]$</field>
    <description>SF Dojo: toegang geweigerd (401/403) op de website.</description>
  </rule>

</group>
