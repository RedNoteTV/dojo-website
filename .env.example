# Kopieer naar .env en pas aan. Maak SECRET_KEY met:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=vervang-mij
# Op de echte server (HTTPS) altijd 1:
HTTPS_ONLY=0
# Alleen 1 als de site achter nginx/Caddy draait (zodat het echte IP gebruikt wordt voor de login-ban):
TRUST_PROXY=0
# Optioneel Kafka:
KAFKA_BROKER=
KAFKA_TOPIC=sfdojo-events
# Gebruikersnamen van de 3 beheerders:
ADMIN1_USER=dev
ADMIN2_USER=righthand
ADMIN3_USER=leader
