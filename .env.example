# Kopieer naar .env en pas aan. Maak SECRET_KEY met:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=vervang-mij
# Op de echte server (HTTPS) altijd 1:
HTTPS_ONLY=0
# Alleen 1 als de site achter nginx/Caddy draait (zodat het echte IP gebruikt wordt voor de login-ban):
TRUST_PROXY=0
# Optioneel Kafka:
KAFKA_BROKER=
KAFKA_TOPIC=sfdojo-events
# Gebruikersnamen van de 3 beheerders:
ADMIN1_USER=dev
ADMIN2_USER=righthand
ADMIN3_USER=leader

# --- Inloggen in het beheer ---------------------------------------------------
# password      = gebruikersnaam + wachtwoord (standaard)
# password_sso  = wachtwoord EN daarna bevestigen met Google/Microsoft (aanbevolen: 2 stappen)
# sso           = alleen Google/Microsoft
AUTH_MODE=password
# Het publieke adres van de site (voor de terugkeer-link van Google/Microsoft), zonder / op het einde
PUBLIC_URL=http://127.0.0.1:8000
# E-mailadressen van de 3 beheerders; meerdere per persoon mag, gescheiden met een komma
ADMIN1_EMAIL=
ADMIN2_EMAIL=
ADMIN3_EMAIL=
# Google: console.cloud.google.com -> API's en services -> Inloggegevens -> OAuth-client-ID (Webtoepassing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: entra.microsoft.com -> App-registraties. Tenant: consumers (privé-accounts) of de tenant-id van een werkaccount
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers
