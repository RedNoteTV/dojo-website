# ============================================================
#  SF Dojo - instellingen.  Dit bestand heet ".env" (met punt, verborgen bestand).
#  Maak het aan met:  python seed.py --init-env
#  Lijn met # ervoor = uitleg. Verander nooit iets zonder te herstarten.
# ============================================================

# --- 1. Basis (verplicht) -------------------------------------
# Geheime sleutel voor sessies en herstelcodes. Lang en willekeurig; NOOIT delen of op GitHub zetten.
SECRET_KEY=vervang-mij
# Op een echte server met https altijd 1. Lokaal op http://127.0.0.1:8000 moet het 0 zijn.
HTTPS_ONLY=0
# 1 als de site achter nginx of Caddy draait (dan wordt het echte IP van bezoekers gebruikt voor de login-ban).
TRUST_PROXY=0
# Het publieke adres, zonder / op het einde. Nodig voor Google/Microsoft.
PUBLIC_URL=http://127.0.0.1:8000

# --- 2. Beheerders --------------------------------------------
ADMIN1_USER=dev
ADMIN2_USER=righthand
ADMIN3_USER=leader

# --- 3. Tweestapsverificatie met een authenticator-app (aanbevolen, geen account bij Google nodig) ---
# 1 = elke beheerder moet na het inloggen een QR-code scannen (Google Authenticator, Microsoft Authenticator, Authy, 2FAS).
REQUIRE_2FA=1

# --- 4. Google / Microsoft inloggen (optioneel, staat UIT zolang dit leeg is) ---
# Vul client-id + secret + e-mailadressen in en de site vraagt voortaan na het wachtwoord een Google/Microsoft-bevestiging.
# Leeg laten = automatisch (uit tot alles ingevuld is). Nodig om te forceren: password (altijd uit), password_sso, sso.
AUTH_MODE=
# E-mailadressen van de 3 beheerders; meerdere per persoon mag, gescheiden met een komma
ADMIN1_EMAIL=
ADMIN2_EMAIL=
ADMIN3_EMAIL=
# Google: console.cloud.google.com -> OAuth-client-ID (Webtoepassing), terugkeer-URI: PUBLIC_URL/admin/sso/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: entra.microsoft.com -> App-registraties, terugkeer-URI: PUBLIC_URL/admin/sso/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# consumers = privé-accounts (Outlook/Hotmail); of de tenant-id van een werk-/schoolaccount
MICROSOFT_TENANT=consumers

# --- 5. Server en container (alleen nodig bij Podman/Caddy) ---
# Je domein; Caddy regelt het https-certificaat zelf. Lokaal laten staan.
DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# --- 6. Optioneel: Kafka-logging en bestandslocaties ---------
KAFKA_BROKER=
KAFKA_TOPIC=sfdojo-events
UPLOAD_DIR=
LOG_FILE=
